# Get a free key at https://serpapi.com (Dashboard → API key)
SERPAPI_KEY=

# Set to 1 to force demo data even with a key (saves quota while tweaking the UI)
MOCK=0

# Rough SGD→INR rate used only to convert bag/fee estimates
NEXT_PUBLIC_SGD_TO_INR=66

# Password for the deployed site (HTTP Basic Auth, any username). Required on Vercel when a real key is set.
# Leave empty locally to skip the login prompt.
APP_PASSWORD=
